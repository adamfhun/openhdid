# OpenHDID – környezeti beállítások (másolja .env néven a compose.yaml mellé).
# Minden telepítési érték itt van; az üzleti paramétereket (csomaglisták, azonosítási
# határok, arculat, adatmegőrzés) a felületen, az Adminisztráció › Rendszer › Beállítások
# alatt kell megadni. Módosítás után: docker compose up -d (a konténerek újraindulnak).
# Titok helyett fájl is megadható: DB_PASSWORD_FILE=/run/secrets/db_password (bármely kulcs).

# --- Kiadás, hálózat, HTTPS ------------------------------------------------------
# A futtatandó image verziója (ghcr.io/adamfhun/openhdid:<verzió>). A letöltött fájlban a kiadás
# verziószáma áll, a kiadási folyamat írja be. Frissítés: átírás az új verzióra,
# majd docker compose pull && docker compose up -d.
OPENHDID_VERSION=1.8.1
# Mely szolgáltatások induljanak: db = beépített MariaDB, redis = Valkey (munkamenet,
# gyorsítótár és üzenetsor; alapból bekapcsolva). Külső adatbázisnál és Valkey-nél (10k profil)
# hagyja üresen, és állítsa a DB_HOST, illetve a REDIS_HOST értékét.
COMPOSE_PROFILES=db,redis
# Használati profil: a compose.yaml mellé a profil kiegészítő fájlja (profiles/5k, profiles/10k;
# a 20k profil Kubernetes-manifeszt, lásd a kubernetes mappát). A profil adja a PHP-FPM, a worker-
# és az adatbázis-méreteket; e fájl ide vonatkozó sorai a profil értékét írják felül.
COMPOSE_FILE=compose.yaml:profiles/5k/compose.yaml
# A profil neve a Rendszerállapot Kapacitás kártyájának (5k, 10k, 20k); a profil fájlja állítja.
# HDID_SIZING_PROFILE=5k
# A gazdagép címe, amelyen a 80-as és 443-as port figyel (0.0.0.0 = minden IPv4-cím).
OPENHDID_BIND_IP=0.0.0.0
OPENHDID_HTTPS_PORT=443
OPENHDID_HTTP_PORT=80
# on = TLS 1.3 a saját tanúsítvánnyal (./tls/fullchain.pem és ./tls/privkey.pem);
# off = csak HTTP a 80-as porton, TLS-t lezáró terheléselosztó mögé (TRUSTED_PROXIES!);
# selfsigned = önaláírt, 30 napos tanúsítvány, kizárólag kipróbáláshoz.
OPENHDID_TLS=on
# A tanúsítvány és a kulcs helye a konténerben (a ./tls mappa ide csatolódik).
OPENHDID_TLS_CERT=/etc/openhdid/tls/fullchain.pem
OPENHDID_TLS_KEY=/etc/openhdid/tls/privkey.pem
# További kiszolgálónevek az APP_URL-beli mellett, szóközzel vagy vesszővel.
OPENHDID_EXTRA_HOSTS=
# A 80-as porton a böngészős GET/HEAD kérés 308-cal a HTTPS-címre megy (false: minden elutasítva).
OPENHDID_HTTP_REDIRECT=true
# A /health és /up címet elérő felügyeleti rendszerek címei (IP vagy CIDR, szóközzel).
OPENHDID_MONITORING_ALLOW=
# nginx-dolgozók száma (auto = processzormagonként egy).
OPENHDID_NGINX_WORKERS=auto
# PHP-FPM folyamatok webkonténerenként; egy folyamat kb. 60–80 MB memóriát használ. Az értékeket
# a választott profil adja (profiles/<név>/compose.yaml); itt csak felülírni kell, ha eltér.
# OPENHDID_FPM_PM=dynamic
# OPENHDID_FPM_MAX_CHILDREN=16
# OPENHDID_FPM_START_SERVERS=4
# OPENHDID_FPM_MIN_SPARE_SERVERS=4
# OPENHDID_FPM_MAX_SPARE_SERVERS=8
# Két alkalmazásgépes telepítésnél (10k profil) a közös storage NFS-kiszolgálója és exportált
# útvonala; a profil fájlja ebből csatolja a kötetet mindkét gépen.
# OPENHDID_NFS_SERVER=nfs.example.org
# OPENHDID_NFS_PATH=/export/openhdid-storage

# --- Kimenő proxy -----------------------------------------------------------------
# Az alkalmazás minden kimenő HTTP(S)-kérése (ügyféltörzs, Exchange, Ozeki SMS, ADFS, Entra) ezen
# megy, a web-, a worker- és az ütemező-konténerből is. Alakja http://gep:port, jelszóval
# http://felhasznalo:jelszo@gep:port (különleges karakter %-kódolva: @ = %40, $ = %24, # = %23); Windows-
# hitelesítésű (NTLM) proxy nem támogatott. Üresen minden kérés közvetlenül megy; a konténer
# HTTP_PROXY/HTTPS_PROXY változóit az alkalmazás nem használja. Az image letöltése nem ezen megy,
# hanem a Docker-démon saját proxyján (TROUBLESHOOTING.md, 4. pont). Az SMTP és az adatbázis nem HTTP.
HDID_HTTP_PROXY=
# A proxy nélkül elért kiszolgálók vesszővel: név (az aldomaineket is lefedi: belso.hu vagy .belso.hu),
# IP-cím vagy tartomány (10.0.0.0/8); a localhost, a 127.0.0.0/8 és a ::1 mindig közvetlen.
# Ide kerülnek a belső kiszolgálók (például az ügyféltörzs, az ADFS, az Exchange, az SMS-átjáró).
HDID_NO_PROXY=

# --- Alkalmazás ------------------------------------------------------------------
APP_NAME=OpenHDID
# production (élesben), staging (ideiglenes hibakereséshez), demo (kipróbáláshoz); más érték
# (például prod vagy Production) indításkor hiba, mert az éles védelmeket kikapcsolná.
APP_ENV=production
# Egyszer kell létrehozni: docker compose run --rm --no-deps web key
# (az image nélkül ugyanilyen kulcs: echo "base64:$(openssl rand -base64 32)")
# A kulccsal titkosított adatok nélküle olvashatatlanok: védett helyen is őrizze meg,
# és meglévő telepítésen soha ne cserélje.
APP_KEY=
APP_DEBUG=false
# A webhely nyilvános címe; ebből képződik a kiszolgálónév is.
APP_URL=https://hdid.example.org
APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=hu_HU
APP_TIMEZONE=Europe/Budapest
# A karbantartási mód (php artisan down) minden példányra hat.
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

# --- Napló -----------------------------------------------------------------------
# A konténer a szabványos kimenetre ír: docker compose logs -f web
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DAILY_DAYS=30
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
# Géppel olvasható, soronkénti JSON-napló (központi naplógyűjtéshez):
# LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

# --- Adatbázis -------------------------------------------------------------------
# A futási fiók csak adatot olvas és ír; a sémát a db.env migrációs fiókja módosítja.
DB_CONNECTION=mariadb
# Beépített adatbázisnál: mariadb; külső szervernél annak neve vagy címe.
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=openhdid
DB_USERNAME=openhdid
# Kötelező: élesben üres jelszóval a konténer nem indul.
DB_PASSWORD=
# Külső adatbázis TLS-kapcsolatához a CA-fájl a konténerben (a ./ca mappa ide csatolódik).
MYSQL_ATTR_SSL_CA=
# A beépített MariaDB memóriája és kapcsolatszáma; a profil (profiles/<név>) saját értéket ad,
# ezek a sorok csak profil nélkül vagy felülíráshoz kellenek.
# OPENHDID_DB_BUFFER_POOL=2G
# OPENHDID_DB_MAX_CONNECTIONS=200

# --- Munkamenet, gyorsítótár, üzenetsor ---------------------------------------------
# Alapból Valkey (redis): egy példányon is leveszi a munkamenetek, a zárak és a sor terhét az
# adatbázisról, több példánynál kötelező. database: csak kipróbáláshoz, Valkey nélkül.
SESSION_DRIVER=redis
# Inaktivitási idő percben; nem abszolút munkamenetkorlát.
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
# A Lax az egyszeri bejelentkezés (SSO) visszatérésével is működik.
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=__Host-openhdid_session
# redis = Valkey (COMPOSE_PROFILES redis profilja vagy külső REDIS_HOST); database csak kipróbáláshoz.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
# Kötelező, ha a gyorsítótár, a sor vagy a munkamenet redis: élesben üresen a konténer nem indul.
# A "docker compose run --rm --no-deps web key" parancs az APP_KEY mellé ehhez is ad értéket.
REDIS_PASSWORD=
REDIS_PORT=6379
# Az ügyféltörzs-átvétel 1200 mp-es korlátjánál nagyobb újrafoglalási idő szükséges.
DB_QUEUE_RETRY_AFTER=1260
REDIS_QUEUE_RETRY_AFTER=1260
BEANSTALKD_QUEUE_RETRY_AFTER=1260

# --- Levelezés -------------------------------------------------------------------
# ews = Microsoft Exchange webszolgáltatás, smtp = SMTP-kiszolgáló. A log csak naplóba ír,
# élesben a rendszerállapot figyelmeztet. Próba: docker compose run --rm web artisan hdid:test-mail cím --now
MAIL_MAILER=log
# smtp esetén: kiszolgáló, port, felhasználó, jelszó; MAIL_SCHEME smtps = közvetlen TLS (465),
# smtp vagy null = STARTTLS-képes kapcsolat (587).
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hdid@example.org"
MAIL_FROM_NAME="${APP_NAME}"
# Az Exchange webszolgáltatás címe; a feladó (MAIL_FROM_ADDRESS) az EWS-fiók vagy küldési joga legyen rá.
EWS_URL=https://mail.example.org/EWS/Exchange.asmx
# basic, ntlm vagy oauth. Az ntlm (Windows-hitelesítés) az image saját, NTLM-képes libcurl-jével
# megy (1.8.1-től); basic és ntlm esetén a postafiók felhasználója és jelszava (tartományi név
# DOMAIN\user alakban idézőjel nélkül vagy aposztrófok között). Ha az Exchange csak NTLM-et kínál
# (próbaküldés: „HTTP 401 … the server offers: NTLM”), EWS_AUTH=ntlm kell.
EWS_AUTH=basic
EWS_USERNAME=
EWS_PASSWORD=
# oauth esetén: az Entra-regisztráció bérlője (GUID), kliensazonosítója és titka, EWS-jogosultsággal.
EWS_OAUTH_TENANT=
EWS_OAUTH_CLIENT_ID=
EWS_OAUTH_CLIENT_SECRET=
EWS_VERIFY_TLS=true

# --- SMS (Ozeki NG) ----------------------------------------------------------------
# ozeki = küldés az átjárón; log = csak naplóba (élesben a rendszerállapot hibát jelez).
SMS_DRIVER=log
OZEKI_URL=https://sms.example.org:9501/api
OZEKI_USERNAME=
OZEKI_PASSWORD=

# --- Ügyféltörzs (Enterprise Master Data, EMD) átvétele -----------------------------
# Átvételi mód: spreadsheet = hitelesített POST → CSV/XLSX; json = régi GET JSON API.
# Az export kéréstörzse (JSON) a panel Beállítások › Ügyféltörzs (EMD) fülén, csak SuperAdmin szerkeszti.
EMD_SYNC_DRIVER=spreadsheet
# Az export végpontjának teljes URL-je.
EMD_SYNC_API_URL=
# Kizárólag a régi json-illesztő statikus Bearer-tokenje és kérési időkorlátja (mp).
EMD_SYNC_API_TOKEN=
EMD_SYNC_API_TIMEOUT=60
# Belépés: POST JSON {Password, Username}; tokenfrissítés: POST JSON {refreshToken}.
# Mindkettő válasza access_token és refresh_token; a roles mezőt figyelmen kívül hagyjuk.
# Ha a tokenfrissítés nem sikerül, a rendszer egyszer újra belép.
# Tartományi név (DOMAIN\user) idézőjel nélkül vagy aposztrófok között; dupla idézőjelben a \n sortörés lesz.
EMD_SYNC_LOGIN_URL=
EMD_SYNC_REFRESH_URL=
EMD_SYNC_USERNAME=
EMD_SYNC_PASSWORD=
# Az API-token 15 percenkénti frissentartása (true/false). false: csak átvételkor frissít.
EMD_SYNC_TOKEN_KEEP_ALIVE=true
# Belépési időkorlát másodpercben; nem a token érvényessége.
EMD_SYNC_AUTH_TIMEOUT=20
# Várt exportfájl: xlsx vagy csv; a letöltés (és az ID-lista lekérdezésének) időkorlátja mp-ben,
# a háttérfeladat 1200 mp-es korlátjánál kisebb.
EMD_SYNC_EXPORT_FORMAT=xlsx
EMD_SYNC_EXPORT_TIMEOUT=600
# CSV-elválasztó (egyetlen karakter); a kódolás a Beállítások › Ügyféltörzs (EMD) fülön állítható.
EMD_SYNC_CSV_DELIMITER=","
# Az ID-lista lekérdezése (POST, ugyanazzal a tokennel); a kijelölt ID-k az export
# kéréstörzsének {{ ids }} helyőrzőjébe kerülnek. Üres = nincs ID-lista.
EMD_SYNC_ID_LIST_URL=
# Ütemezett teljes átvétel cron-kifejezéssel; üres = csak kézzel.
EMD_SYNC_CRON="0 */3 * * *"
# A panelről indított átvétel saját sora; a sync-worker szolgáltatás dolgozza fel.
EMD_SYNC_QUEUE=sync

# --- Telefonközpont ----------------------------------------------------------------
# Örökölt, rögzített kulcs; helyette a felületen kezelt API-kulcsok ajánlottak.
CALLCENTER_API_KEY=
CALLCENTER_HMAC_SECRET=
# Az aláírt kérés időbélyegének megengedett eltérése másodpercben.
CALLCENTER_SIGNATURE_TTL=300

# --- Egyszeri bejelentkezés (négy külön alkalmazás-regisztráció) --------------------
USER_ADFS_ISSUER=
USER_ADFS_CLIENT_ID=
USER_ADFS_CLIENT_SECRET=
# ADFS: a fiók e-mail-címével összevetett igények (claimek) sorrendben, vesszővel; az első használható dönt.
# Üresen: emailaddress,email,upn,preferred_username,unique_name. A név a teljes igénytípus-URI végére is
# illeszkedik (…/claims/emailaddress). A rendszer az ID tokent és az access tokent is nézi: az ADFS a kiadási
# szabályok igényeit allatclaims nélkül csak az access tokenbe teszi (ugyanazzal a kulccsal aláírva, ennek az
# alkalmazásnak kiadva fogadjuk el). Az elutasítás okát és a tokenekben talált igények nevét az auditnapló mutatja.
USER_ADFS_EMAIL_CLAIM=
# ADFS: az "openid profile email" mellé kért további hatókörök (például allatclaims), szóközzel vagy vesszővel.
# Nem kötelező; üresen nincs. Olyan hatókört, amelyet az ADFS ennek a kliensnek nem enged, ne adjon meg.
USER_ADFS_SCOPES=
# ADFS: a Web API azonosítója a "resource" paraméterben (ennek a kiadási szabályai kerülnek az access tokenbe).
# Nem kötelező; üresen nem küldjük.
USER_ADFS_RESOURCE=
# Entra: a saját címtár GUID-ja (Directory (tenant) ID); domain, common, organizations nem jó.
USER_ENTRA_TENANT=
USER_ENTRA_CLIENT_ID=
USER_ENTRA_CLIENT_SECRET=
CLIENT_ADFS_ISSUER=
CLIENT_ADFS_CLIENT_ID=
CLIENT_ADFS_CLIENT_SECRET=
# Az ügyfél-alkalmazás ADFS-igényei, hatókörei és Web API-ja, mint a USER_ADFS_* fent.
CLIENT_ADFS_EMAIL_CLAIM=
CLIENT_ADFS_SCOPES=
CLIENT_ADFS_RESOURCE=
CLIENT_ENTRA_TENANT=
CLIENT_ENTRA_CLIENT_ID=
CLIENT_ENTRA_CLIENT_SECRET=
# Az ügyfél mobilalkalmazásának külön Entra-kliensazonosítója (a mobil tokencsere csak ügyfélnek van).
CLIENT_ENTRA_MOBILE_CLIENT_ID=
# Az ügyfélbelépés ügyféltörzs-feltétele: alapból (true) az ügyfél csak az e-mail-címét viselő, jelen lévő
# ügyféltörzstétellel léphet be. false esetén tétel nélkül is beléphet (például kézzel felvett ügyfél); a lezárás,
# a jogosító csomag és a minden kérésnél futó ellenőrzés marad. Munkatársra nem hat; a rendszerállapot sárgán jelzi.
CLIENT_LOGIN_REQUIRE_EMD=true
# Kétlépcsős munkatársi belépés: az ellenőrzött SSO ID token amr igényének azon értékei, amelyek igazolják, hogy a
# céges szolgáltató már kért második faktort (beépítve: Entra „mfa”, ADFS „http://schemas.microsoft.com/claims/multipleauthn”).
# Vesszővel további értékek adhatók hozzá; csak akkor számít, ha a Beállításokban a szolgáltató MFA-jának elfogadása be van kapcsolva.
HDID_MFA_PROVIDER_AMR=
# ADFS hibakeresés: true esetén minden ADFS-belépés a kérést, a tokenválaszt, a két token fejlécét és tartalmát az érkezett
# alakban és visszafejtve (személyes adatokkal) warning szinten az alkalmazásnaplóba írja; az aláírás (csak a hossza) és a
# frissítő token nem kerül bele, így a naplóban nincs újra felhasználható token.
# Csak az ADFS-igények beállításának idejére; a rendszerállapot sárgán jelzi, amíg be van kapcsolva.
HDID_ADFS_DEBUG=false

# --- Egyéb -----------------------------------------------------------------------
HDID_PHONE_REGION=HU
# A TLS-t lezáró terheléselosztó címe(i) OPENHDID_TLS=off esetén; mindenkit megbízhatónak
# vevő érték (*, **, 0.0.0.0/0, ::/0) élesben nem használható.
TRUSTED_PROXIES=127.0.0.1
# Mobilalkalmazás bejelentkezésének lejárata percben (43200 = 30 nap).
SANCTUM_TOKEN_EXPIRATION=43200
HDID_CSP_ENABLED=true
HDID_CSP_EXTRA_SOURCES=
# A „Forráskód” hivatkozás címe; az image a saját kiadására mutat. Módosított változat
# üzemeltetésekor a módosított forrásra kell mutatnia (AGPL-3.0, 13. pont).
# HDID_SOURCE_URL=
# A „Forráskód” hivatkozás megjelenítése a láblécekben (true/false). false elrejti; az AGPL-3.0 13. pontja
# szerint a hálózati felhasználóknak ekkor más úton kell felajánlani a forrást.
SHOW_SC=true

# --- Kipróbálás --------------------------------------------------------------------
# true: a migráció egyszer betölti a demóadatokat (ügyintéző, két ügyfél, hívások).
# Csak APP_ENV=demo mellett működik, mert a demófiókok jelszava nyilvános.
OPENHDID_DEMO_DATA=false
