# OpenHDID – környezeti beállítások (másolja .env néven a compose.yaml mellé).
# Minden telepítési érték itt van; az üzleti paramétereket (csomaglisták, azonosítási
# határok, arculat, adatmegőrzés) a felületen, az Adminisztráció › Rendszer › Beállítások
# alatt kell megadni. Módosítás után: docker compose up -d (a konténerek újraindulnak).
# Titok helyett fájl is megadható: DB_PASSWORD_FILE=/run/secrets/db_password (bármely kulcs).

# --- Kiadás, hálózat, HTTPS ------------------------------------------------------
# A futtatandó image verziója (ghcr.io/adamfhun/openhdid:<verzió>). A letöltött fájlban a kiadás
# verziószáma áll, a kiadási folyamat írja be. Frissítés: átírás az új verzióra,
# majd docker compose pull && docker compose up -d.
OPENHDID_VERSION=1.15.0
# Mely szolgáltatások induljanak: db = beépített MariaDB, redis = Valkey (munkamenet,
# gyorsítótár és üzenetsor; alapból bekapcsolva). Külső adatbázisnál és Valkey-nél (10k profil)
# hagyja üresen, és állítsa a DB_HOST, illetve a REDIS_HOST értékét.
COMPOSE_PROFILES=db,redis
# Használati profil: a compose.yaml mellé a profil kiegészítő fájlja (profiles/5k/compose.yaml egy
# gépre, profiles/10k/single.yaml a 10k-ra egy gépen, profiles/10k/compose.yaml a kétgépes 10k
# alkalmazásgépeire; a 20k profil Kubernetes-manifeszt, lásd a kubernetes mappát). A profil adja a
# PHP-FPM, a worker- és az adatbázis-méreteket; e fájl ide vonatkozó sorai a profil értékét írják
# felül. A telepítő (./install.sh) ezt a sort a választott profil szerint írja.
COMPOSE_FILE=compose.yaml:profiles/5k/compose.yaml
# A profil neve a Rendszerállapot Kapacitás kártyájának (5k, 10k-single, 10k, 20k); a profil fájlja
# állítja.
# HDID_SIZING_PROFILE=5k
# A Compose-projekt neve (a konténerek, kötetek és a hálózat előtagja). Üresen a compose.yaml neve
# (openhdid). Csak akkor kell, ha egy gépen több telepítés fut (például egy próbapéldány az éles
# mellett): mindegyik mappa .env-je saját nevet kapjon. A backup.sh és az install.sh a telepítés
# .env-jéből követi; meglévő telepítésen ne változtassa (a régi név kötetei a régi adatot őrzik).
# COMPOSE_PROJECT_NAME=openhdid
# A gazdagép címe, amelyen a 80-as és 443-as port figyel (0.0.0.0 = minden IPv4-cím).
OPENHDID_BIND_IP=0.0.0.0
OPENHDID_HTTPS_PORT=443
OPENHDID_HTTP_PORT=80
# on = TLS 1.3 a saját tanúsítvánnyal (./tls/fullchain.pem és ./tls/privkey.pem);
# off = csak HTTP a 80-as porton, TLS-t lezáró terheléselosztó mögé (TRUSTED_PROXIES!);
# selfsigned = önaláírt, 30 napos tanúsítvány, kizárólag kipróbáláshoz.
OPENHDID_TLS=on
# A tanúsítvány és a kulcs helye a konténerben (a ./tls mappa ide csatolódik).
OPENHDID_TLS_CERT=/etc/openhdid/tls/fullchain.pem
OPENHDID_TLS_KEY=/etc/openhdid/tls/privkey.pem
# További kiszolgálónevek az APP_URL-beli mellett, szóközzel vagy vesszővel. Az alkalmazás is csak
# ezeket és az APP_URL gazdagépét fogadja el (más Host vagy X-Forwarded-Host: 400); a hivatkozások
# (belépési levél, átirányítások, űrlapok) ettől függetlenül mindig az APP_URL címével készülnek, ezért
# böngészőből a panel és a portál csak az APP_URL címén használható; a további nevek gépi hívásokra
# (telefonközpont, IVR, mobil háttérrendszer, életjel-próba) valók.
OPENHDID_EXTRA_HOSTS=
# A 80-as porton a böngészős GET/HEAD kérés 308-cal a HTTPS-címre megy (false: minden elutasítva).
OPENHDID_HTTP_REDIRECT=true
# A /health és /up címet elérő felügyeleti rendszerek címei (IP vagy CIDR, szóközzel).
OPENHDID_MONITORING_ALLOW=
# nginx-dolgozók száma. Üresen a használati profil értéke (profil nélkül 2, az 5k és a 10k profilban
# 4): ezzel számol a web memóriaplafonja (OPENHDID_WEB_MEM_LIMIT), egy dolgozó teli kapcsolatpufferekkel
# kb. 80 MB. auto = processzormagonként egy: több magos gépen a plafont is emelni kell, különben
# induláskor figyelmeztetés jön.
OPENHDID_NGINX_WORKERS=
# Kéréskorlát kliens-címenként az alkalmazás felé (a statikus fájlok nem számítanak): legfeljebb ennyi
# kérés másodpercenként, és egyszerre legfeljebb ennyivel több (löket); felette az nginx 429-es,
# indoklással és Retry-After fejléccel ellátott választ ad, a naplóba „limiting requests” sort ír.
# A kliens-cím terheléselosztó mögött (OPENHDID_TLS=off) a TRUSTED_PROXIES címeiről érkező
# X-Forwarded-For szerinti cím. Az alapérték (20/s, egyszerre 100) egy böngészős felhasználónak bőven
# elég, de egy profil normál csúcsát több címre osztja; egy NAT mögül dolgozó ügyfélszolgálat egy
# címnek számít, ezért azt a HDID_RATE_LIMIT_EXEMPT_NETWORKS mentesíti, nem a korlát emelése.
# Ha minden kérés ugyanarról a címről érkezik (rootless Docker alapértelmezett portkezelése, IPv6-os
# kliensek IPv6-NAT nélkül, a TLS-t újratitkosító előtét OPENHDID_TLS=on mellett, vagy terheléselosztó
# TRUSTED_PROXIES nélkül), a korlát az egész forgalomra hat: ilyenkor emelje, vagy 0, illetve hagyja
# a TLS-t az előtétre (OPENHDID_TLS=off); a konténer indulásakor ezt a naplóban figyelmeztetés jelzi.
# Terheléses méréshez (deploy/k6) a tesztpéldányon 0, különben a 429-ek a mérést torzítják.
# 0 = nincs korlát (a konténer indulásakor figyelmeztetés a naplóban).
OPENHDID_NGINX_RATE_LIMIT=20
OPENHDID_NGINX_RATE_BURST=100
# Egy kliens-cím egyszerre legfeljebb ennyi kérést tarthat az alkalmazásban (minden HTTP/2-folyam
# külön számít); felette 429. Így néhány cím nem foglalhatja le az összes PHP-FPM-folyamatot. Egy NAT
# mögötti ügyfélszolgálatnak bőven elég. A korlátok kulcsa IPv4-en a cím, IPv6-on a /64-es hálózat
# (egy előfizető egy teljes /64-et kap, azon belül szabadon válthatna címet). 0 = nincs korlát.
OPENHDID_NGINX_CONN_LIMIT=16
# A kliens-cím szerinti korlátok alól mentesített hálózatok (IPv4 és IPv6, cím vagy CIDR, vesszővel
# vagy szóközzel), például egy vállalat NAT-címe, amely mögül minden felhasználó ugyanarról a címről
# jön. Rájuk nem hat az nginx kéréskorlátja (OPENHDID_NGINX_RATE_LIMIT/BURST) és egyidejű-kérés-
# korlátja (OPENHDID_NGINX_CONN_LIMIT), sem az alkalmazás címenkénti korlátai (belépési és céges
# belépési útvonalak, a panel belépési korlátja). NEM mentesít a címenkénti (e-mail), számonkénti és
# rendszerszintű korlátok (belépési hivatkozás és SMS-kód óránként, naponta), a gépi API-kulcsok
# korlátja és a hitelesítés alól. Legfeljebb /8 (IPv4) és /32 (IPv6) széles; *, 0.0.0.0/0, ::/0 vagy
# érvénytelen elem esetén a konténer nem indul. Terheléselosztó mögött (OPENHDID_TLS=off) a
# TRUSTED_PROXIES-ben szereplő elosztó X-Forwarded-For fejléce szerinti valódi kliens-cím számít.
# Üresen senki nem mentes.
HDID_RATE_LIMIT_EXEMPT_NETWORKS=
# Lassú kliensek ellen: ennyi másodpercig hallgathat a kliens a kéréstörzs küldése és a válasz
# fogadása közben, és ennyi ideig marad nyitva egy tétlen kapcsolat (5–300). A kérés fejlécére
# 10 másodperc jut. A kéréstörzs legfeljebb 4 MB, a fájlfeltöltésé 11 MB.
OPENHDID_NGINX_CLIENT_TIMEOUT=15
# PHP-FPM folyamatok webkonténerenként. Az értékeket a választott profil adja (profiles/<név>/
# compose.yaml); itt csak felülírni kell, ha eltér. Egy folyamat normál üzemben kb. 40–80 MB-ot
# használ, de a felső határa a memory_limit (OPENHDID_FPM_MEMORY_LIMIT, alapból 128M) és kb. 22 MB:
# a web memóriaplafonja (OPENHDID_WEB_MEM_LIMIT) ebből számol, ezért a kettőt együtt kell emelni.
# A rendszerállapot Kapacitás kártyája jelzi, ha a folyamatok × memory_limit nem fér a plafonba.
# OPENHDID_FPM_PM=dynamic
# OPENHDID_FPM_MAX_CHILDREN=12
# OPENHDID_FPM_START_SERVERS=4
# OPENHDID_FPM_MIN_SPARE_SERVERS=4
# OPENHDID_FPM_MAX_SPARE_SERVERS=8
# Egy webes kérés memóriakorlátja (az import, az ügyféltörzs-átvétel és a nagy exportok a
# feldolgozóban futnak, vagy folyamként mennek, ott 256M marad).
# OPENHDID_FPM_MEMORY_LIMIT=128M
# Ennyi kérés várhat szabad PHP-FPM-folyamatra; ha ez is betelt, az nginx azonnal 503-at ad
# (Retry-After fejléccel), és nem perceken át várakoztat.
# OPENHDID_FPM_BACKLOG=64
# A webkonténer memóriaplafonja: folyamatok × (memory_limit + 22 MB) + 208 MB opcache + nginx-
# dolgozók × 80 MB + 256 MB /tmp + 64 MB tartalék. Profil nélkül 1920m, 5k és 10k profilban 2688m.
# OPENHDID_WEB_MEM_LIMIT=2688m
# Két alkalmazásgépes telepítésnél (10k profil) a közös storage NFS-kiszolgálója és exportált
# útvonala; a profil fájlja ebből csatolja a kötetet mindkét gépen.
# OPENHDID_NFS_SERVER=nfs.example.org
# OPENHDID_NFS_PATH=/export/openhdid-storage

# --- Kimenő proxy -----------------------------------------------------------------
# Az alkalmazás minden kimenő HTTP(S)-kérése (ügyféltörzs, Exchange, Ozeki SMS, ADFS, Entra) ezen
# megy, a web-, a worker- és az ütemező-konténerből is. Alakja http://gep:port, jelszóval
# http://felhasznalo:jelszo@gep:port (különleges karakter %-kódolva: @ = %40, $ = %24, # = %23); Windows-
# hitelesítésű (NTLM) proxy nem támogatott. Üresen minden kérés közvetlenül megy; a konténer
# HTTP_PROXY/HTTPS_PROXY változóit az alkalmazás nem használja. Az image letöltése nem ezen megy,
# hanem a Docker-démon saját proxyján (TROUBLESHOOTING.md, 4. pont). Az SMTP és az adatbázis nem HTTP.
HDID_HTTP_PROXY=
# A proxy nélkül elért kiszolgálók vesszővel: név (az aldomaineket is lefedi: belso.hu vagy .belso.hu),
# IP-cím vagy tartomány (10.0.0.0/8); a localhost, a 127.0.0.0/8 és a ::1 mindig közvetlen.
# Ide kerülnek a belső kiszolgálók (például az ügyféltörzs, az ADFS, az Exchange, az SMS-átjáró).
HDID_NO_PROXY=

# --- Alkalmazás ------------------------------------------------------------------
APP_NAME=OpenHDID
# production (élesben), staging (ideiglenes hibakereséshez), demo (kipróbáláshoz); más érték
# (például prod vagy Production) indításkor hiba, mert az éles védelmeket kikapcsolná.
APP_ENV=production
# Egyszer kell létrehozni: docker compose run --rm --no-deps web key
# (az image nélkül ugyanilyen kulcs: echo "base64:$(openssl rand -base64 32)")
# A kulccsal titkosított adatok nélküle olvashatatlanok: védett helyen is őrizze meg,
# és meglévő telepítésen soha ne cserélje.
APP_KEY=
APP_DEBUG=false
# A webhely nyilvános címe; ebből képződik a kiszolgálónév is.
APP_URL=https://hdid.example.org
APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=hu_HU
APP_TIMEZONE=Europe/Budapest
# A karbantartási mód (php artisan down) minden példányra hat.
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

# --- Napló -----------------------------------------------------------------------
# A konténer a szabványos kimenetre ír: docker compose logs -f web
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DAILY_DAYS=30
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
# Géppel olvasható, soronkénti JSON-napló (központi naplógyűjtéshez):
# LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

# --- Adatbázis -------------------------------------------------------------------
# A futási fiók csak adatot olvas és ír; a sémát a db.env migrációs fiókja módosítja.
DB_CONNECTION=mariadb
# Beépített adatbázisnál: mariadb; külső szervernél annak neve vagy címe.
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=openhdid
DB_USERNAME=openhdid
# Kötelező: élesben üres jelszóval a konténer nem indul.
DB_PASSWORD=
# Külső adatbázis TLS-kapcsolatához a CA-fájl a konténerben (a ./ca mappa ide csatolódik).
MYSQL_ATTR_SSL_CA=
# A beépített MariaDB memóriája és kapcsolatszáma; a profil (profiles/<név>) saját értéket ad,
# ezek a sorok csak profil nélkül vagy felülíráshoz kellenek. A kapcsolatszám legalább a PHP-FPM
# folyamatok, a feldolgozók, az ütemező (3), a migráció és néhány tartalék összege (5k: 40, profil
# nélkül 25). A konténer memóriaplafonja: puffer + kb. 192 MB + kapcsolatszám × 20 MB (5k: 2g,
# profil nélkül 1g); a pufferrel és a kapcsolatszámmal együtt kell emelni.
# OPENHDID_DB_BUFFER_POOL=1G
# OPENHDID_DB_MAX_CONNECTIONS=40
# OPENHDID_DB_MEM_LIMIT=2g

# --- Munkamenet, gyorsítótár, üzenetsor ---------------------------------------------
# Alapból Valkey (redis): egy példányon is leveszi a munkamenetek, a zárak és a sor terhét az
# adatbázisról, több példánynál kötelező. database: csak kipróbáláshoz, Valkey nélkül.
# A munkamenetek saját Valkey-be kerülnek (a redis profil valkey-sessions szolgáltatása), amely
# betelve a legrégebben használt munkameneteket szorítja ki; a sor, a zárak és a korlátszámlálók a
# fő Valkey-ben maradnak. A munkamenetek Redis-kapcsolata SESSION_DRIVER=redis mellett a
# "session" (SESSION_CONNECTION); más értéket csak különleges esetben kell megadni.
SESSION_DRIVER=redis
# Inaktivitási idő percben; nem abszolút munkamenetkorlát.
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
# A Lax az egyszeri bejelentkezés (SSO) visszatérésével is működik.
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=__Host-openhdid_session
# redis = Valkey (COMPOSE_PROFILES redis profilja vagy külső REDIS_HOST); database csak kipróbáláshoz.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
# Kötelező, ha a gyorsítótár, a sor vagy a munkamenet redis: élesben üresen a konténer nem indul.
# A "docker compose run --rm --no-deps web key" parancs az APP_KEY mellé ehhez is ad értéket.
REDIS_PASSWORD=
REDIS_PORT=6379
# A munkamenetek és a sor (REDIS_DB, alapból 0) és a gyorsítótár (REDIS_CACHE_DB, alapból 1)
# Valkey-adatbázisa. A visszaállítás és a backup.sh signout mindkettőt teljesen kiüríti: egy Valkey-
# adatbázist csak egy telepítés használjon, és a menedzselt Valkey engedje a FLUSHDB parancsot.
# REDIS_DB=0
# REDIS_CACHE_DB=1
# A munkamenetek Valkey-je. Üresen a compose.yaml a beépített valkey-sessions szolgáltatást adja
# (ha a REDIS_HOST=valkey); külső Valkey-nél (10k, 20k profil) egy második példány címe kell ide,
# maxmemory-policy allkeys-lru beállítással, különben a munkamenetek a fő Valkey-ben maradnak (a
# rendszerállapot Munkamenet-tár kártyája ilyenkor sárga). Az üres REDIS_SESSION_PORT, _PASSWORD,
# _USERNAME és _DB a REDIS_* párját veszi át. A munkamenetek áthelyezése egyszer mindenkit kiléptet.
REDIS_SESSION_HOST=
REDIS_SESSION_PORT=
REDIS_SESSION_PASSWORD=
REDIS_SESSION_USERNAME=
REDIS_SESSION_DB=
# A kulcsok előtagja a Valkey-ben. Üresen az APP_NAME-ből képződik (openhdid-database-, a
# gyorsítótárnál openhdid-cache-), ami minden azonos nevű telepítésnél ugyanaz: egy Valkey-t csak egy
# telepítés használjon, és ha egy teszt- vagy staging-példány is ugyanazt látja, mindkettő kapjon saját
# előtagot (legalább külön adatbázissal és ACL-felhasználóval). A rendszerállapot Valkey / Redis
# csempéje külső Valkey-n sárga, amíg a REDIS_PREFIX az alapérték; a beépített (valkey) szolgáltatásnál,
# amelyet más telepítés nem ér el, csak tájékoztat. Meglévő telepítésen csak üres sor mellett cserélje:
# előbb docker compose stop web scheduler, a feldolgozók elvégzik a várakozó feladatokat (docker compose
# exec worker php artisan queue:monitor redis:priority,redis:default,redis:sync nullát mutat), utána csere és
# docker compose up -d. A régi előtag alatt maradt feladatok elvesznek, és minden munkamenet véget ér.
# REDIS_PREFIX=openhdid-eles-
# CACHE_PREFIX=openhdid-eles-cache-
# A beépített Valkey memóriakorlátja (maxmemory) és a konténer memóriaplafonja (profil nélkül és az
# 5k profilban 256mb és 768m). A plafon a maxmemory kétszerese és még 256 MB: az AOF-újraírás
# forkja teli tár mellett is elfér. Betelt korlátnál a Valkey nem dob el kulcsot (maxmemory-policy
# noeviction), hanem az írást utasítja el; a rendszerállapot 80 % felett figyelmeztet. Külső vagy
# menedzselt Valkey-n a noeviction kötelező, ott a szolgáltató felületén kell beállítani.
# OPENHDID_VALKEY_MAXMEMORY=256mb
# OPENHDID_VALKEY_MEM_LIMIT=768m
# A munkamenet-Valkey (valkey-sessions) memóriakorlátja és a konténer plafonja (profil nélkül 128mb
# és 384m, az 5k profilban 384mb és 896m): a kétszeres terhelés munkamenetei a teljes 120 perces
# élettartamra. A plafon a maxmemory kétszerese és még 128 MB (RDB-pillanatkép forkja). Betelve a
# legrégebben használt munkamenetek szorulnak ki (maxmemory-policy allkeys-lru); a rendszerállapot
# Munkamenet-tár kártyája sárga, ha az elmúlt órában kiszorítás volt.
# OPENHDID_VALKEY_SESSIONS_MAXMEMORY=384mb
# OPENHDID_VALKEY_SESSIONS_MEM_LIMIT=896m
# Az ügyféltörzs-átvétel 1200 mp-es korlátjánál nagyobb újrafoglalási idő szükséges.
DB_QUEUE_RETRY_AFTER=1260
REDIS_QUEUE_RETRY_AFTER=1260
BEANSTALKD_QUEUE_RETRY_AFTER=1260
# A belépési hivatkozások és kódok (ügyfél és munkatárs) elsőbbségi sora: így más üzenetek
# torlódása sem késlelteti őket az érvényességükön túl. A worker szolgáltatás sorlista nélkül
# előbb ezt, utána a default sort dolgozza fel. Üres = default, minden üzenet egy soron.
HDID_PRIORITY_QUEUE=priority

# --- Levelezés -------------------------------------------------------------------
# ews = Microsoft Exchange webszolgáltatás, smtp = SMTP-kiszolgáló. A log csak naplóba ír,
# élesben a rendszerállapot figyelmeztet. Próba: docker compose run --rm web artisan hdid:test-mail cím --now
MAIL_MAILER=log
# smtp esetén: kiszolgáló, port, felhasználó, jelszó; MAIL_SCHEME smtps = közvetlen TLS (465),
# smtp vagy null = STARTTLS-sel titkosított kapcsolat (587).
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
# A STARTTLS kötelező: ha a kiszolgáló nem kínálja, a küldés hibával megáll, a jelszó és a levél nem megy
# ki titkosítatlanul. Közvetlen TLS-nél (smtps) közömbös. false csak titkosítás nélküli helyi
# próbakiszolgálóhoz; ilyenkor a rendszerállapot Levelezés kártyája sárga. Kikapcsolni csak a false érték
# tudja: üres vagy hibás érték mellett a STARTTLS kötelező marad.
MAIL_REQUIRE_TLS=true
MAIL_FROM_ADDRESS="hdid@example.org"
MAIL_FROM_NAME="${APP_NAME}"
# Az Exchange webszolgáltatás címe; a feladó (MAIL_FROM_ADDRESS) az EWS-fiók vagy küldési joga legyen rá.
EWS_URL=https://mail.example.org/EWS/Exchange.asmx
# basic, ntlm vagy oauth. Az ntlm (Windows-hitelesítés) az image saját, NTLM-képes libcurl-jével
# megy (1.8.1-től); basic és ntlm esetén a postafiók felhasználója és jelszava (tartományi név
# DOMAIN\user alakban idézőjel nélkül vagy aposztrófok között). Ha az Exchange csak NTLM-et kínál
# (próbaküldés: „HTTP 401 … the server offers: NTLM”), EWS_AUTH=ntlm kell.
EWS_AUTH=basic
EWS_USERNAME=
EWS_PASSWORD=
# oauth esetén: az Entra-regisztráció bérlője (GUID), kliensazonosítója és titka, EWS-jogosultsággal.
EWS_OAUTH_TENANT=
EWS_OAUTH_CLIENT_ID=
EWS_OAUTH_CLIENT_SECRET=
EWS_VERIFY_TLS=true

# --- SMS (Ozeki NG) ----------------------------------------------------------------
# ozeki = küldés az átjárón; log = csak naplóba (élesben a rendszerállapot hibát jelez).
SMS_DRIVER=log
OZEKI_URL=https://sms.example.org:9501/api
OZEKI_USERNAME=
OZEKI_PASSWORD=
# SMS kézbesítési jelentés: a küldés után ennyi másodperccel kérdezi le a rendszer az átjárótól az üzenet állapotát
# (az átjáró által adott azonosítóval), vesszővel, legfeljebb öt alkalom, mindegyik 1 és 86400 között; üresen 30,120,300,1800,7200.
# Kézbesítve vagy nem kézbesíthető jelentés lezárja a követést; az utolsó lekérdezés után jelentés nélkül „nincs jelentés”.
# A nem kézbesíthető SMS-t a rendszer nem küldi újra magától.
SMS_DELIVERY_CHECKS=
# Ozeki: az állapot-lekérdezés HTTP API-művelete (action) és az átjáró állapotszavai, amelyek kézbesítettet, illetve nem
# kézbesíthetőt jelentenek (vesszővel, kis-nagybetű nem számít). Üresen: querymessage; delivered,deliveredtohandset;
# undelivered,notsent,deliveryfailed,failed,rejected,expired. A saját átjárón ellenőrizendő: az üzenet adatlapja mutatja a nyers állapotot.
OZEKI_STATUS_ACTION=
OZEKI_DELIVERED_STATUSES=
OZEKI_UNDELIVERED_STATUSES=

# --- Ügyféltörzs (Enterprise Master Data, EMD) átvétele -----------------------------
# Átvételi mód: spreadsheet = hitelesített POST → CSV/XLSX; json = régi GET JSON API.
# Az export kéréstörzse (JSON) a panel Beállítások › Ügyféltörzs (EMD) fülén, csak SuperAdmin szerkeszti.
EMD_SYNC_DRIVER=spreadsheet
# Az export végpontjának teljes URL-je.
EMD_SYNC_API_URL=
# Kizárólag a régi json-illesztő statikus Bearer-tokenje és kérési időkorlátja (mp).
EMD_SYNC_API_TOKEN=
EMD_SYNC_API_TIMEOUT=60
# Belépés: POST JSON {Password, Username}; tokenfrissítés: POST JSON {refreshToken}.
# Mindkettő válasza access_token és refresh_token; a roles mezőt figyelmen kívül hagyjuk.
# Ha a tokenfrissítés nem sikerül, a rendszer egyszer újra belép.
# Tartományi név (DOMAIN\user) idézőjel nélkül vagy aposztrófok között; dupla idézőjelben a \n sortörés lesz.
EMD_SYNC_LOGIN_URL=
EMD_SYNC_REFRESH_URL=
EMD_SYNC_USERNAME=
EMD_SYNC_PASSWORD=
# Az API-token 15 percenkénti frissentartása (true/false). false: csak átvételkor frissít.
EMD_SYNC_TOKEN_KEEP_ALIVE=true
# Belépési időkorlát másodpercben; nem a token érvényessége.
EMD_SYNC_AUTH_TIMEOUT=20
# Várt exportfájl: xlsx vagy csv; a letöltés (és az ID-lista lekérdezésének) időkorlátja mp-ben,
# a háttérfeladat 1200 mp-es korlátjánál kisebb.
EMD_SYNC_EXPORT_FORMAT=xlsx
EMD_SYNC_EXPORT_TIMEOUT=600
# CSV-elválasztó (egyetlen karakter); a kódolás a Beállítások › Ügyféltörzs (EMD) fülön állítható.
EMD_SYNC_CSV_DELIMITER=","
# Az ID-lista lekérdezése (POST, ugyanazzal a tokennel); a kijelölt ID-k az export
# kéréstörzsének {{ ids }} helyőrzőjébe kerülnek. Üres = nincs ID-lista.
EMD_SYNC_ID_LIST_URL=
# Ütemezett teljes átvétel cron-kifejezéssel; üres = csak kézzel.
EMD_SYNC_CRON="0 */3 * * *"
# A panelről indított átvétel saját sora; a sync-worker szolgáltatás dolgozza fel.
EMD_SYNC_QUEUE=sync

# --- Telefonközpont ----------------------------------------------------------------
# Örökölt, rögzített kulcs; helyette a felületen kezelt API-kulcsok ajánlottak.
CALLCENTER_API_KEY=
CALLCENTER_HMAC_SECRET=
# Az aláírt kérés időbélyegének megengedett eltérése másodpercben.
CALLCENTER_SIGNATURE_TTL=300

# --- Egyszeri bejelentkezés (négy külön alkalmazás-regisztráció) --------------------
USER_ADFS_ISSUER=
USER_ADFS_CLIENT_ID=
USER_ADFS_CLIENT_SECRET=
# ADFS: a fiók e-mail-címével összevetett igények (claimek) sorrendben, vesszővel; az első használható dönt.
# Üresen: emailaddress,email,upn,preferred_username,unique_name. A név a teljes igénytípus-URI végére is
# illeszkedik (…/claims/emailaddress). A rendszer az ID tokent és az access tokent is nézi: az ADFS a kiadási
# szabályok igényeit allatclaims nélkül csak az access tokenbe teszi (ugyanazzal a kulccsal aláírva, ennek az
# alkalmazásnak kiadva fogadjuk el). Az elutasítás okát és a tokenekben talált igények nevét az auditnapló mutatja.
USER_ADFS_EMAIL_CLAIM=
# ADFS: az "openid profile email" mellé kért további hatókörök (például allatclaims), szóközzel vagy vesszővel.
# Nem kötelező; üresen nincs. Olyan hatókört, amelyet az ADFS ennek a kliensnek nem enged, ne adjon meg.
USER_ADFS_SCOPES=
# ADFS: a Web API azonosítója a "resource" paraméterben (ennek a kiadási szabályai kerülnek az access tokenbe).
# Nem kötelező; üresen nem küldjük.
USER_ADFS_RESOURCE=
# Egyszeri bejelentkezés: a fiókot megtaláló igény (claim). email (alapérték): a token e-mail-címe találja meg a fiókot
# (és azon át az ügyféltörzstételt); employee_id: a token dolgozói azonosítója, az ügyféltörzstétel külső azonosítójával
# összevetve (a token e-mailje ekkor nem számít, mert ez a mód éppen a változó címekre való). Mindkét módban az első belépés a
# fiókot a szolgáltató állandó azonosítójához (Entra oid, ADFS sub) köti; utána ugyanarra a címre más azonosítóval érkező
# belépés elutasul (a rendszergazda a fiókon vagy a hdid:sso-unbind paranccsal oldja). Ismeretlen érték: a szolgáltató
# „nincs beállítva”.
USER_SSO_MATCH=email
# employee_id módban a dolgozói azonosítót hordozó igény neve (ADFS-nél az igénytípus-URI végződése is jó); üresen employeeId.
USER_SSO_EMPLOYEE_ID_CLAIM=
# Entra: a saját címtár GUID-ja (Directory (tenant) ID); domain, common, organizations nem jó.
USER_ENTRA_TENANT=
USER_ENTRA_CLIENT_ID=
USER_ENTRA_CLIENT_SECRET=
CLIENT_ADFS_ISSUER=
CLIENT_ADFS_CLIENT_ID=
CLIENT_ADFS_CLIENT_SECRET=
# Az ügyfél-alkalmazás ADFS-igényei, hatókörei és Web API-ja, mint a USER_ADFS_* fent.
CLIENT_ADFS_EMAIL_CLAIM=
CLIENT_ADFS_SCOPES=
CLIENT_ADFS_RESOURCE=
# Az ügyfél-alkalmazás fiókot megtaláló igénye és dolgozói azonosító igénye, mint a USER_SSO_* fent.
CLIENT_SSO_MATCH=email
CLIENT_SSO_EMPLOYEE_ID_CLAIM=
CLIENT_ENTRA_TENANT=
# Ügyfélportál több Entra-bérlőből: a bérlők GUID-jai vesszővel; egy bérlő után kettősponttal és | jellel elválasztva
# azok az e-mail-domainek, amelyek fiókjait a bérlő beléptetheti (szűrő); domain nélkül a bérlő megbízható, bármely
# ügyféltörzsbeli címet beléptethet. Több bérlőnél a rendszer a közös "organizations" végpontot használja, és a token
# bérlőjét (tid) a listához köti. Egy bérlőnél elég a CLIENT_ENTRA_TENANT; ha mindkettő ki van töltve, az egyes bérlő
# a lista részének számít, és a rendszerállapot sárgán jelzi; ugyanaz a domain több bérlőnél szintén sárga. Csak GUID alakú
# azonosító fogadott el (elgépelés esetén a szolgáltató „nincs beállítva”). A regisztráció ilyenkor többbérlős legyen.
# Példa: 11111111-1111-1111-1111-111111111111,22222222-2222-2222-2222-222222222222:partner.hu|partner.com
CLIENT_ENTRA_TENANTS=
CLIENT_ENTRA_CLIENT_ID=
CLIENT_ENTRA_CLIENT_SECRET=
# Az ügyfél mobilalkalmazásának külön Entra-kliensazonosítója (a mobil tokencsere csak ügyfélnek van).
CLIENT_ENTRA_MOBILE_CLIENT_ID=
# Egyszeri bejelentkezés: a szolgáltató állandó azonosítója (Entra oid, ADFS sub) nélkül érkező token elutasítása (true,
# alapérték). false esetén az ilyen belépés kötés nélkül, csak az e-mail (vagy dolgozói azonosító) alapján lép be, és az
# audit jelzi; csak olyan szolgáltatónál indokolt, amely az azonosítót nem adja ki.
HDID_SSO_REQUIRE_SUBJECT=true
# Az ügyfélbelépés ügyféltörzs-feltétele: alapból (true) az ügyfél csak az e-mail-címét viselő, jelen lévő
# ügyféltörzstétellel léphet be. false esetén tétel nélkül is beléphet (például kézzel felvett ügyfél); a lezárás,
# a jogosító csomag és a minden kérésnél futó ellenőrzés marad. Munkatársra nem hat; a rendszerállapot sárgán jelzi.
CLIENT_LOGIN_REQUIRE_EMD=true
# Kétlépcsős munkatársi belépés: az ellenőrzött SSO ID token amr igényének azon értékei, amelyek igazolják, hogy a
# céges szolgáltató már kért második faktort (beépítve: Entra „mfa”, ADFS „http://schemas.microsoft.com/claims/multipleauthn”).
# Vesszővel további értékek adhatók hozzá; csak akkor számít, ha a Beállításokban a szolgáltató MFA-jának elfogadása be van kapcsolva.
HDID_MFA_PROVIDER_AMR=
# ADFS hibakeresés: true esetén minden ADFS-belépés a kérést, a tokenválaszt, a két token fejlécét és tartalmát az érkezett
# alakban és visszafejtve (személyes adatokkal) warning szinten az alkalmazásnaplóba írja; az aláírás (csak a hossza) és a
# frissítő token nem kerül bele, így a naplóban nincs újra felhasználható token.
# Csak az ADFS-igények beállításának idejére; a rendszerállapot sárgán jelzi, amíg be van kapcsolva.
HDID_ADFS_DEBUG=false

# --- Egyéb -----------------------------------------------------------------------
HDID_PHONE_REGION=HU
# A TLS-t lezáró terheléselosztó címe(i) OPENHDID_TLS=off esetén; mindenkit megbízhatónak
# vevő érték (*, **, 0.0.0.0/0, ::/0) élesben nem használható. A kliens címét az nginx csak ezektől
# a címektől veszi át (X-Forwarded-For); a többi továbbító fejlécet (X-Forwarded-Host, -Proto, -Port,
# -Prefix, Forwarded) mindig a saját, ellenőrzött értékére cseréli: kiszolgálónév az APP_URL-ből vagy az
# OPENHDID_EXTRA_HOSTS-ból, https, az APP_URL portja. A listában szereplő tartomány minden gépe hamis
# kliens-címet adhat át, ezért csak a terheléselosztó (Kubernetesen az ingress-vezérlő) legyen benne,
# és a 8080-as port csak felőle legyen elérhető (Kubernetesen: kubernetes/base/networkpolicy.yaml).
TRUSTED_PROXIES=127.0.0.1
# Mobilalkalmazás bejelentkezésének lejárata percben (43200 = 30 nap).
SANCTUM_TOKEN_EXPIRATION=43200
HDID_CSP_ENABLED=true
HDID_CSP_EXTRA_SOURCES=
# A „Forráskód” hivatkozás címe; az image a saját kiadására mutat. Módosított változat
# üzemeltetésekor a módosított forrásra kell mutatnia (AGPL-3.0, 13. pont).
# HDID_SOURCE_URL=
# A „Forráskód” hivatkozás megjelenítése a láblécekben (true/false). false elrejti; az AGPL-3.0 13. pontja
# szerint a hálózati felhasználóknak ekkor más úton kell felajánlani a forrást.
SHOW_SC=true

# --- Kipróbálás --------------------------------------------------------------------
# true: a migráció egyszer betölti a demóadatokat (ügyintéző, két ügyfél, hívások).
# Csak APP_ENV=demo mellett működik, mert a demófiókok jelszava nyilvános.
# Élesítés előtt a demó adatbázisát törölni kell (docker compose down -v, a feltöltött fájlokkal együtt):
# APP_ENV=production mellett a migrate leáll, amíg az adatbázisban demóadat van, a demófiókok nem
# léphetnek be, és a rendszerállapot „Demóadatok” csempéje piros.
OPENHDID_DEMO_DATA=false
