#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

// Before the cached config, services and packages are loaded: a cache file another
// account wrote must not run with the rights of whoever starts artisan (App\System\CacheOwnership).
if (($refusal = App\System\CacheOwnership::refusal($app)) !== null) {
    fwrite(STDERR, $refusal.PHP_EOL);

    exit(78);
}

$status = $app->handleCommand(new ArgvInput);

exit($status);
