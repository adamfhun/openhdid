#!/bin/sh
# OpenHDID container entrypoint. Prepares the runtime from the environment and
# starts one role:
#
#   web                 nginx + PHP-FPM (portal, staff panel, APIs)
#   worker [queues]     queue worker; queues default to "<HDID_PRIORITY_QUEUE, else priority>,default"
#   scheduler           Laravel scheduler (replaces cron), exactly one per installation
#   migrate             waits for the database, runs migrations and the role seeder
#   artisan <args>      any artisan command, e.g. artisan hdid:make-admin admin@example.org
#   key                 prints a new APP_KEY for a new installation (never replace a live key)
#   reload              re-checks the TLS files and reloads nginx without dropping connections
#   tls-check           validates the mounted certificate and key, prints a summary
#   check-env [role]    runs the start checks of a role (default web) and exits; nothing starts
#   healthcheck [live]  used by the image HEALTHCHECK (PHP-FPM answers /up); "live" asks nginx only
#   version             prints the release version
set -eu
# Files written at run time (the config cache with every secret, logs, uploads, the CA bundle)
# are for this account and its group only; the container has no other account anyway.
umask 027

APP_DIR=/app
SHARE=/usr/local/share/openhdid
RUNTIME=/tmp/openhdid

log() { printf '%s openhdid: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }
die() { log "ERROR: $*"; exit 64; }

# NAME_FILE=/run/secrets/x becomes NAME=<file content> (Docker and Kubernetes secrets).
# COMPOSE_FILE is Docker Compose's own variable: the .env Compose reads is also the
# containers' env_file, so it arrives here, but it names Compose files, not a secret.
load_file_secrets() {
    for name in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)_FILE=.*/\1/p'); do
        [ "$name" = COMPOSE ] && continue
        file=$(printenv "${name}_FILE")
        [ -r "$file" ] || die "${name}_FILE points to a file that cannot be read: $file"
        if [ -n "$(printenv "$name" 2>/dev/null || true)" ]; then
            die "both $name and ${name}_FILE are set; keep only one"
        fi
        value=$(cat "$file")
        export "$name=$value"
        unset "${name}_FILE"
    done
}

prepare_dirs() {
    mkdir -p "$RUNTIME/cache" "$RUNTIME/views" "$RUNTIME/run" "$RUNTIME/php" \
        "$RUNTIME/nginx/body" "$RUNTIME/nginx/fastcgi" "$RUNTIME/tls"
    for dir in app/public app/private framework/cache/data framework/sessions framework/views logs; do
        mkdir -p "$APP_DIR/storage/$dir" 2>/dev/null || die "storage volume is not writable by uid $(id -u) ($APP_DIR/storage/$dir)"
    done
    [ -w "$APP_DIR/storage/app" ] || die "storage volume is not writable by uid $(id -u) ($APP_DIR/storage/app)"
}

# Extra CA certificates (internal Exchange, SSO, EMD or database CA) mounted as *.crt / *.pem.
prepare_ca_bundle() {
    extra=$(find /etc/openhdid/ca -maxdepth 1 -type f \( -name '*.crt' -o -name '*.pem' \) 2>/dev/null | sort)
    [ -n "$extra" ] || return 0
    # shellcheck disable=SC2086
    cat /etc/ssl/certs/ca-certificates.crt $extra > "$RUNTIME/ca-bundle.pem"
    printf 'openssl.cafile = %s\ncurl.cainfo = %s\n' "$RUNTIME/ca-bundle.pem" "$RUNTIME/ca-bundle.pem" > "$RUNTIME/php/zz-ca.ini"
    log "trusting $(printf '%s\n' "$extra" | wc -l | tr -d ' ') extra CA file(s) from /etc/openhdid/ca"
}

warm_caches() {
    cd "$APP_DIR"
    php artisan config:cache --no-interaction >/dev/null
    php artisan route:cache --no-interaction >/dev/null
    php artisan event:cache --no-interaction >/dev/null
    if [ "$1" = web ]; then
        php artisan view:cache --no-interaction >/dev/null
    fi
}

# The bundled session Valkey (valkey-sessions, compose.yaml) comes with the bundled main one
# (REDIS_HOST=valkey). With an external REDIS_HOST the sessions stay there until
# REDIS_SESSION_HOST names a second server of its own; the Session store card says so.
session_store() {
    if [ "${REDIS_SESSION_HOST:-}" = valkey-sessions ] && [ "${REDIS_HOST:-}" != valkey ]; then
        unset REDIS_SESSION_HOST
    fi
}

prepare() {
    role=$1
    load_file_secrets
    session_store
    prepare_dirs
    prepare_ca_bundle
    printf '%s\n' "$role" > "$RUNTIME/role"
    php "$SHARE/runtime.php" check-env "$role"
    warm_caches "$role"
}

render_nginx() {
    php "$SHARE/runtime.php" nginx-config > "$RUNTIME/nginx/nginx.conf.new"
    nginx -t -q -e stderr -c "$RUNTIME/nginx/nginx.conf.new"
    mv "$RUNTIME/nginx/nginx.conf.new" "$RUNTIME/nginx/nginx.conf"
}

run_web() {
    render_nginx
    php-fpm -F -y /usr/local/etc/php-fpm.conf &
    fpm=$!
    nginx -e stderr -c "$RUNTIME/nginx/nginx.conf" -g 'daemon off;' &
    ngx=$!
    stopping=0
    # Graceful stop: nginx finishes open requests, PHP-FPM its running scripts.
    trap 'stopping=1; kill -QUIT "$ngx" "$fpm" 2>/dev/null || true' TERM INT QUIT
    log "web started (nginx $ngx, php-fpm $fpm)"
    while kill -0 "$fpm" 2>/dev/null && kill -0 "$ngx" 2>/dev/null; do
        sleep 1 &
        wait $! || true
    done
    [ "$stopping" = 1 ] || log "a web process exited unexpectedly; stopping the container"
    kill -QUIT "$ngx" "$fpm" 2>/dev/null || true
    wait "$ngx" 2>/dev/null || true
    wait "$fpm" 2>/dev/null || true
    [ "$stopping" = 1 ] && exit 0
    exit 1
}

cmd=${1:-web}
[ $# -gt 0 ] && shift

case "$cmd" in
    web)
        prepare web
        run_web
        ;;
    worker)
        # Default: the priority queue of the sign-in codes and links first, then the default one.
        priority_queue=${HDID_PRIORITY_QUEUE:-priority}
        if [ "$priority_queue" = default ]; then
            default_queues=default
        else
            default_queues="${priority_queue},default"
        fi
        queues=${1:-${OPENHDID_WORKER_QUEUES:-$default_queues}}
        prepare worker
        log "worker listening on queue(s): $queues"
        # No PHP time limit for the worker: php.ini's 300 s is for web requests, a
        # 20 000-row EMD sync can use more CPU time; the job's own 1200 s timeout
        # (pcntl) remains the guard against a stuck run. Above 192 MB the worker
        # restarts after the job, well before memory_limit (256M) would stop one.
        exec php -d max_execution_time=0 artisan queue:work --queue="$queues" --sleep=3 --tries=1 --max-time=3600 --memory=192 --no-interaction
        ;;
    scheduler)
        prepare scheduler
        log "scheduler started"
        exec php artisan schedule:work --no-interaction
        ;;
    migrate)
        prepare migrate
        php "$SHARE/runtime.php" wait-db
        # Two application servers may start at once (10k profile): with a shared
        # Valkey the migration runs under a lock, one at a time. The database cache
        # store cannot lock before its own table exists, so the flag depends on it.
        isolated=""
        [ "${CACHE_STORE:-database}" = redis ] && isolated="--isolated"
        # shellcheck disable=SC2086
        php artisan migrate --force --no-interaction $isolated
        php artisan db:seed --class='Database\Seeders\RolesAndPermissionsSeeder' --force --no-interaction
        php "$SHARE/runtime.php" demo-data
        log "database is up to date"
        ;;
    artisan)
        prepare artisan
        exec php artisan "$@"
        ;;
    key)
        # The application key and a Valkey password, ready to paste into .env.
        php -r 'echo "APP_KEY=base64:", base64_encode(random_bytes(32)), PHP_EOL, "REDIS_PASSWORD=", bin2hex(random_bytes(24)), PHP_EOL;'
        ;;
    reload)
        load_file_secrets
        render_nginx
        nginx -e stderr -c "$RUNTIME/nginx/nginx.conf" -s reload
        log "nginx reloaded"
        ;;
    tls-check)
        load_file_secrets
        exec php "$SHARE/runtime.php" tls-check
        ;;
    check-env)
        # The same start checks as a role (install.sh check reads the ERROR and warning lines).
        load_file_secrets
        session_store
        exec php "$SHARE/runtime.php" check-env "${1:-web}"
        ;;
    healthcheck)
        exec php "$SHARE/runtime.php" healthcheck "$@"
        ;;
    version)
        printf '%s\n' "${HDID_VERSION:-unknown}"
        ;;
    *)
        die "unknown command '$cmd' (web, worker, scheduler, migrate, artisan, key, reload, tls-check, check-env, healthcheck, version)"
        ;;
esac
